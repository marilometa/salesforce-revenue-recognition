    <description>Creates Project Deliverables on a newly imported legacy Project based on the Opportunity products. Triggers when a Project is created with a linked Opportunity.</description>
    <environments>Default</environments>
    <interviewLabel>Create Deliverables for Legacy Project {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Deliverables for Legacy Project</label>
