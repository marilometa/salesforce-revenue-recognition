<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Initialize_Counter</name>
        <label>Initialize Counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Records_Deliverables_Line_Item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>StoreGetRecordstoVar</name>
        <label>StoreGetRecordstoVar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExistingDLI</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Records_Deliverables_Line_Item</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>DLIs_Already_Exist</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_New_DLI</name>
        <label>Build New DLI</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>tempDLI.Project_Deliverable__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Delivery_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Quantity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Unit_Value__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Unit_Price__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_To_Collection</name>
        <label>Add To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collNewDLIs</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tempDLI</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Increment_Counter</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Counter</name>
        <label>Increment Counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCounter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Counter_Quantity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Counter_Quantity</name>
        <label>Counter &lt;= Quantity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Done - Create Collection</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Create_Deliverable_Line_Items</targetReference>
        </defaultConnector>
        <rules>
            <name>Yes_Build_DLI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCounter</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>DeliverableQty</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_New_DLI</targetReference>
            </connector>
            <label>Yes_Build_DLI</label>
        </rules>
    </decisions>
    <decisions>
        <name>DLIs_Already_Exist</name>
        <label>DLIs Already Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_DLIs_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingDLI</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Counter_Quantity</targetReference>
            </connector>
            <label>No_DLIs_Exist</label>
        </rules>
    </decisions>
    <description>Creates one Deliverable Line Item per unit of Quantity when a Project Deliverable is created. Idempotent on create (skips if DLIs already exist for the deliverable). Build-collection-then-single-DML pattern to stay within DML governor limits even at high quantities. Quantity-change handling for existing deliverables is performed by Sync_DLIs_On_OLI_Quantity_Change (triggered on OpportunityLineItem) because Project_Deliverable__c.Quantity__c is a formula field and formula recalculations do not fire record-triggered flows.</description>
    <environments>Default</environments>
    <formulas>
        <name>DeliverableQty</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Create Deliverable Line Items from Quantity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Deliverable Line Items from Quantity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Single bulk DML create of all built Deliverable Line Items.</description>
        <name>Create_Deliverable_Line_Items</name>
        <label>Create Deliverable Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>collNewDLIs</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Records_Deliverables_Line_Item</name>
        <label>Get Records Deliverables Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>StoreGetRecordstoVar</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project_Deliverable__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Deliverable_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Initialize_Counter</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Quantity__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>Project_Deliverable__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>collNewDLIs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
    <variables>
        <name>tempDLI</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
    <variables>
        <name>varCounter</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varExistingDLI</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
</Flow>
