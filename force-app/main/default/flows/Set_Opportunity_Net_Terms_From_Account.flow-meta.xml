<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Copy the parent Account&apos;s Net_Terms__c (Invoice Payment Terms) onto the new Opportunity. Runs in before-save context so the assignment is part of the same DML and incurs no extra transaction overhead.</description>
        <name>Inherit_From_Account</name>
        <label>Inherit Net Terms From Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Net_Terms__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Net_Terms__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Copies Net_Terms__c (Invoice Payment Terms) from parent Account to new Opportunity on Create. Users can override the inherited value at any time post-create. Before-save flow; cross-object access to Account.Net_Terms__c is supported via lookup-relationship dot notation without an explicit Get Records.</description>
    <environments>Default</environments>
    <interviewLabel>Set Opportunity Net Terms From Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Opportunity Net Terms From Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Inherit_From_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Net_Terms__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
