<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_Existing_Count</name>
        <label>Increment Existing Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExistingCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Loop_Count_DLIs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Init_Build_Counter</name>
        <label>Init Build Counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingCount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCounter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Counter_Quantity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_New_DLI</name>
        <label>Build New DLI</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>tempDLI.Project_Deliverable__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Related_Deliverable.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Delivery_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Quantity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempDLI.Unit_Value__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_New_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_To_New_Collection</name>
        <label>Add To New Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collNewDLIs</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tempDLI</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Increment_Build_Counter</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Build_Counter</name>
        <label>Increment Build Counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCounter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Counter_Quantity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Compute_Delete_Count</name>
        <label>Compute Delete Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varToDelete</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingCount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varToDelete</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Pending_DLIs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_To_Delete_Collection</name>
        <label>Add To Delete Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collDLIsToDelete</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Pending_DLIs</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varDeleted</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Pending_DLIs</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Deliverable_Exists</name>
        <label>Deliverable Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Project Deliverable Yet</defaultConnectorLabel>
        <rules>
            <name>Yes_Deliverable_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Deliverable.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_DLIs</targetReference>
            </connector>
            <label>Yes_Deliverable_Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Compare_Quantities</name>
        <label>New Qty vs Existing Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Equal - No Action</defaultConnectorLabel>
        <rules>
            <name>Increase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varExistingCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Init_Build_Counter</targetReference>
            </connector>
            <label>Increase</label>
        </rules>
        <rules>
            <name>Decrease</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>varExistingCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Compute_Delete_Count</targetReference>
            </connector>
            <label>Decrease</label>
        </rules>
    </decisions>
    <decisions>
        <name>Counter_Quantity</name>
        <label>Counter &lt;= Quantity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Done - Create Collection</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Create_New_DLIs</targetReference>
        </defaultConnector>
        <rules>
            <name>Yes_Build_DLI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCounter</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Quantity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_New_DLI</targetReference>
            </connector>
            <label>Yes_Build_DLI</label>
        </rules>
    </decisions>
    <decisions>
        <name>Need_More_Deletions</name>
        <label>Need More Deletions?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Done - Skip Rest</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Loop_Pending_DLIs</targetReference>
        </defaultConnector>
        <rules>
            <name>Yes_Add_To_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDeleted</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>varToDelete</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_Delete_Collection</targetReference>
            </connector>
            <label>Yes_Add_To_Delete</label>
        </rules>
    </decisions>
    <description>Keeps Deliverable Line Items in sync with Opportunity Product Quantity changes after the Project already exists. On OLI Quantity change: counts existing DLIs, then either creates the delta of new DLIs (Quantity increase) or deletes Pending DLIs newest-first (Quantity decrease). Never deletes DLIs marked Delivered. Lives on OpportunityLineItem because Project_Deliverable__c.Quantity__c is a formula derived from OLI Quantity, and formula-only recalculations do not fire record-triggered flows.</description>
    <environments>Default</environments>
    <interviewLabel>Sync DLIs On OLI Quantity Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync DLIs on OLI Quantity Change</label>
    <loops>
        <name>Loop_Count_DLIs</name>
        <label>Loop Count DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_DLIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Existing_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Compare_Quantities</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Pending_DLIs</name>
        <label>Loop Pending DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Pending_DLIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Need_More_Deletions</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Delete_DLIs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Single bulk DML create of all new DLIs needed to match the new Quantity.</description>
        <name>Create_New_DLIs</name>
        <label>Create New DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>collNewDLIs</inputReference>
    </recordCreates>
    <recordDeletes>
        <description>Single bulk DML delete of Pending DLIs above the new Quantity. Delivered DLIs are never deleted.</description>
        <name>Delete_DLIs</name>
        <label>Delete DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>collDLIsToDelete</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Related_Deliverable</name>
        <label>Get Related Deliverable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Deliverable_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Deliverable__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Project_Deliverable__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_All_DLIs</name>
        <label>Get All DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Count_DLIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project_Deliverable__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Deliverable.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Deliverable_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Pending DLIs only, newest first. We delete the most recently created Pending DLIs first because they are least likely to have any in-flight work.</description>
        <name>Get_Pending_DLIs</name>
        <label>Get Pending DLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Pending_DLIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project_Deliverable__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Deliverable.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Delivery_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Deliverable_Line_Item__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Deliverable</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Quantity}), {!$Record.Quantity} &gt; 0)</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>collDLIsToDelete</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
    <variables>
        <name>collNewDLIs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
    <variables>
        <name>tempDLI</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Deliverable_Line_Item__c</objectType>
    </variables>
    <variables>
        <name>varCounter</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varDeleted</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varExistingCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varToDelete</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
