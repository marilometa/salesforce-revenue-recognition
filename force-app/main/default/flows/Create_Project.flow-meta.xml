<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_a_collection</name>
        <label>Add to a collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collNewDeliverables</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tempNewDeliverable</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Opportunity_Products</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Add_New_Deliverable</name>
        <label>Build &amp; Add New Deliverable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>tempNewDeliverable.Deliverable_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempNewDeliverable.Deliverable__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Opportunity_Products.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tempNewDeliverable.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNewProjectId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_a_collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_the_new_project_id_to_a_variable</name>
        <label>Store the new project id to a variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewProjectId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Project_records.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Opportunity_Products</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Opportunity_Close_won_and_no_project</name>
        <label>Opportunity Close won and no project?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_project_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Commit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Commit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Project</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Project_records</targetReference>
            </connector>
            <label>No project exists</label>
        </rules>
    </decisions>
    <description>Create Project with Deliverables when an Opportunity transitions into the Commit stage. Idempotent: skips creation if a Project already exists for the Opportunity. Builds Project_Deliverable__c records in a collection and creates them in a single DML after the loop.</description>
    <environments>Default</environments>
    <formulas>
        <name>ProjectNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} + &quot; - Project&quot;</expression>
    </formulas>
    <formulas>
        <description>Project standard Name: uses the legacy Project Number when present, otherwise falls back to &quot;OppName - Project&quot;. Driven by data-migration scenario where Opp.Project_Number__c carries an external tracker number.</description>
        <name>ProjectStandardName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Project_Number__c}), {!ProjectNameFormula}, {!$Record.Project_Number__c})</expression>
    </formulas>
    <interviewLabel>Create Project {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Project with Deliverables on Opportunity Commit</label>
    <loops>
        <name>Loop_Through_Opportunity_Products</name>
        <label>Loop Through Opportunity Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Opportunity_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Add_New_Deliverable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Project_Deliverable</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Project_Deliverable</name>
        <label>Create Project Deliverable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>collNewDeliverables</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Project_records</name>
        <label>Create Project records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Store_the_new_project_id_to_a_variable</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.Account.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Kickoff_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>ProjectStandardName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Manager__c</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Name__c</field>
            <value>
                <elementReference>ProjectNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Notes__c</field>
            <value>
                <elementReference>ProjectNotesText</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Status__c</field>
            <value>
                <stringValue>Planned</stringValue>
            </value>
        </inputAssignments>
        <object>Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity_Products</name>
        <label>Get Opportunity Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Opportunity_Products</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Project</name>
        <label>Get Related Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Opportunity_Close_won_and_no_project</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Project</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Commit</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ProjectNotesText</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Auto-created from Opportunity: {!$Record.Name}
Key Actions / Notes: {!$Record.Key_Actions_for_Closure_and_Key_Notes__c}
Close Date: {!$Record.CloseDate}
Amount: {!$Record.Amount}
Description: {!$Record.Description}</text>
    </textTemplates>
    <variables>
        <name>collNewDeliverables</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Project_Deliverable__c</objectType>
    </variables>
    <variables>
        <name>tempNewDeliverable</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Project_Deliverable__c</objectType>
    </variables>
    <variables>
        <description>ID of the newly created Project</description>
        <name>varNewProjectId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
