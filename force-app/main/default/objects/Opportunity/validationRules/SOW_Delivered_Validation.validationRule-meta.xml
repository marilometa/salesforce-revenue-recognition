<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOW_Delivered_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
  ISPICKVAL(StageName, &quot;Negotiate&quot;),
  SOW_Delivered__c = FALSE
)</errorConditionFormula>
    <errorDisplayField>SOW_Delivered__c</errorDisplayField>
    <errorMessage>Please upload the Statement of Work (SOW) before proceeding to the negotiation stage and mark this checkbox.</errorMessage>
</ValidationRule>
