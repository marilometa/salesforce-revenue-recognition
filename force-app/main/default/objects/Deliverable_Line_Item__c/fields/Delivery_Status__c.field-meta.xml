<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivery_Status__c</fullName>
    <description>Indicates the current delivery state of this individual deliverable unit. Used by Operations to track progress and by Salesforce to roll up delivery status to the parent Deliverable and Project.</description>
    <inlineHelpText>Shows the delivery progress for this unit of work. Update the status as the unit moves from planning to completion. Mark as Delivered only once the unit has been fully completed.</inlineHelpText>
    <label>Delivery Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>false</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Ongoing</fullName>
                <default>false</default>
                <label>Ongoing</label>
            </value>
            <value>
                <fullName>Delivered</fullName>
                <default>false</default>
                <label>Delivered</label>
            </value>
            <value>
                <fullName>Delayed</fullName>
                <default>false</default>
                <label>Delayed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
